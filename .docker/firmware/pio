#!/usr/bin/env bash
# Runs PlatformIO in the firmware container (compose.yaml next to this script), as your user, so
# PlatformIO doesn't have to be installed on your PC. From anywhere in the repository:
#   .docker/firmware/pio run -e teensy40      # build the firmware for the Teensy 4.0
#   .docker/firmware/pio run -e teensy31      # and for the Teensy 3.1/3.2
# It builds the image first, then runs pio in diffbot_firmware with the arguments you give it.
# Docker reuses the last build when the Dockerfile and requirements.txt haven't changed.
# LOCAL_UID and LOCAL_GID are your user and group ID unless you set them, for example
#   LOCAL_UID=1234 LOCAL_GID=1234 .docker/firmware/pio run -e teensy40
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LOCAL_UID="${LOCAL_UID:-$(id -u)}"
export LOCAL_GID="${LOCAL_GID:-$(id -g)}"
compose=(docker compose -f "$here/compose.yaml")

"${compose[@]}" build --quiet firmware

# Without a terminal, for example in CI, run without one
tty_flag=()
if [ ! -t 0 ] || [ ! -t 1 ]; then
    tty_flag=(-T)
fi
exec "${compose[@]}" run --rm ${tty_flag[@]+"${tty_flag[@]}"} firmware pio "$@"
