# Settings for compose.yaml, the robot's bringup in Docker. Copy this file to .env in the same
# folder, then change the values for your robot:
#   cd ~/diffbot/.docker/robot && cp env.example .env
# Docker Compose reads .env from this folder. Each line is NAME=value, without spaces around the
# = sign. Compose doesn't run shell commands here, so write numbers and paths out. A line that
# starts with # is a comment: the setting then keeps its default. .env stays on the robot: git and
# the image build ignore it.

# The robot: remo or diffbot. It selects the robot model (URDF) and the controller's wheel radius
# and separation, so it must match the robot the container runs on.
ROBOT_MODEL=remo

# Start the lidar driver together with the bringup: remove the # in front of the next line.
#COMPOSE_PROFILES=lidar

# The ROS network (see ROS Network Setup): the address of the PC that runs roscore, and this
# robot's own IP address. Without ROS_MASTER_URI, roslaunch starts a ROS master on the robot.
#ROS_MASTER_URI=http://192.168.1.10:11311
#ROS_IP=192.168.1.20

# The serial devices on the host. The defaults are the names from 99-diffbot-robot.rules.
#TEENSY_DEVICE=/dev/teensy
#LIDAR_DEVICE=/dev/rplidar

# The numeric ID of the host's group that owns the serial devices (default 20, dialout on
# Ubuntu). Find it with: stat -Lc %g /dev/teensy
#DIALOUT_GID=20

# The host folder for ROS logs and bags (default: robot-data in the home folder). It must exist
# and be writable for UID 1000, the user ros in the container.
#ROBOT_DATA=/home/robot/robot-data
