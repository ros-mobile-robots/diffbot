<launch>
    <!-- Starts the diffbot model in Gazebo and runs two tests on it: publishtest checks that the
         controllers publish, test_drive.py drives the robot and checks its odometry and true pose -->
    <include file="$(find diffbot_gazebo)/test/sim_drive.launch">
        <arg name="model" value="diffbot"/>
        <arg name="gazebo_port" value="11351"/>
    </include>

    <!-- publishtest is a test node that comes with rostest (http://wiki.ros.org/rostest/Nodes#publishtest):
         it passes when each topic below gets a message within its timeout. negative: True would
         check the opposite, that nothing is published -->
    <test test-name="publish_diffbot" pkg="rostest" type="publishtest" time-limit="120">
        <rosparam>
            topics:
              - name: /diffbot/joint_states
                timeout: 90
                negative: False
              - name: /diffbot/mobile_base_controller/odom
                timeout: 90
                negative: False
        </rosparam>
    </test>

    <test test-name="drive_diffbot" pkg="diffbot_gazebo" type="test_drive.py" time-limit="180"/>
</launch>
