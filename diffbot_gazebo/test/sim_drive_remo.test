<launch>
    <!-- Starts the remo model in Gazebo and runs five tests on it. rostest starts the simulation
         again for each test.
         1. publishtest: the controllers publish the joint states and the odometry.
         2. test_drive.py: the robot drives forward and turns, and its odometry and its true pose
            match the commands.
         3. test_imu.py: the simulated IMU publishes the firmware's message at rest and a positive
            yaw rate in a left turn.
         4. test_imu_reset.py: the IMU publishes again right after a reset of the simulation.
         5. test_odom_tf.py: only the drive controller publishes the transform
            odom → base_footprint -->
    <include file="$(find diffbot_gazebo)/test/sim_drive.launch">
        <arg name="model" value="remo"/>
        <arg name="gazebo_port" value="11352"/>
    </include>

    <!-- publishtest is a test node that comes with rostest (http://wiki.ros.org/rostest/Nodes#publishtest):
         it passes when each topic below gets a message within its timeout. negative: True would
         check the opposite, that nothing is published -->
    <test test-name="publish_remo" pkg="rostest" type="publishtest" time-limit="120">
        <rosparam>
            topics:
              - name: /diffbot/joint_states
                timeout: 90
                negative: False
              - name: /diffbot/mobile_base_controller/odom
                timeout: 90
                negative: False
        </rosparam>
    </test>

    <test test-name="drive_remo" pkg="diffbot_gazebo" type="test_drive.py" time-limit="180"/>

    <!-- The simulated IMU (test_imu.py): rate, frame, the orientation marked unavailable, gravity
         at rest, and the yaw rate's sign in a left turn -->
    <test test-name="imu_remo" pkg="diffbot_gazebo" type="test_imu.py" time-limit="120"/>

    <!-- The simulated IMU after /gazebo/reset_simulation (test_imu_reset.py): samples with stamps
         of the new simulation time arrive right after the clock went back to zero -->
    <test test-name="imu_reset_remo" pkg="diffbot_gazebo" type="test_imu_reset.py" time-limit="180"/>
    <!-- test_odom_tf.py checks that exactly one node publishes the transform
         odom → base_footprint: the node that the publisher parameter names. Two publishers of
         one transform would make the robot's pose jump between their two values.
         This simulation runs without the EKF, so the drive controller publishes the transform.
         In the simulation, the drive controller is not a node of its own. gazebo_ros_control
         loads the drive controller into Gazebo's process, whose node name is /gazebo. So
         publisher is /gazebo -->
    <test test-name="odom_tf_remo" pkg="diffbot_gazebo" type="test_odom_tf.py" time-limit="180">
        <param name="publisher" value="/gazebo"/>
    </test>
</launch>
