<launch>
    <!-- Starts the remo model in Gazebo and runs four tests on it: publishtest checks that the
         controllers publish, test_drive.py drives the robot and checks its odometry and true pose,
         test_imu.py checks the simulated IMU, test_odom_tf.py that only the drive controller
         publishes odom → base_footprint. rostest starts the simulation again for each test -->
    <include file="$(find diffbot_gazebo)/test/sim_drive.launch">
        <arg name="model" value="remo"/>
        <arg name="gazebo_port" value="11352"/>
    </include>

    <!-- publishtest is a test node that comes with rostest (http://wiki.ros.org/rostest/Nodes#publishtest):
         it passes when each topic below gets a message within its timeout. negative: True would
         check the opposite, that nothing is published -->
    <test test-name="publish_remo" pkg="rostest" type="publishtest" time-limit="120">
        <rosparam>
            topics:
              - name: /diffbot/joint_states
                timeout: 90
                negative: False
              - name: /diffbot/mobile_base_controller/odom
                timeout: 90
                negative: False
        </rosparam>
    </test>

    <test test-name="drive_remo" pkg="diffbot_gazebo" type="test_drive.py" time-limit="180"/>

    <!-- The simulated IMU (test_imu.py): rate, frame, the orientation marked unavailable, gravity
         at rest, and the yaw rate's sign in a left turn -->
    <test test-name="imu_remo" pkg="diffbot_gazebo" type="test_imu.py" time-limit="120"/>
    <!-- Without the EKF, the drive controller publishes odom → base_footprint, from inside
         Gazebo (gazebo_ros_control), and nobody else -->
    <test test-name="odom_tf_remo" pkg="diffbot_gazebo" type="test_odom_tf.py" time-limit="180">
        <param name="publisher" value="/gazebo"/>
    </test>
</launch>
