{
  "name": "DiffBot (ROS 1 Noetic)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  "remoteUser": "ros",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/catkin_ws/src/diffbot,type=bind",
  "workspaceFolder": "/home/ros/catkin_ws/src/diffbot",
  // Host network, so ROS nodes in the container can talk to the robot and to RViz on the host
  "runArgs": ["--network=host"],
  // GUI apps (RViz, Gazebo, rqt) use the host's X server (on Windows: WSLg).
  // host-x11.sh prepares the socket directory and the X11 cookie for native Linux desktops.
  "initializeCommand": "bash .devcontainer/noetic/host-x11.sh",
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/tmp/.diffbot-${localEnv:USER}.xauth,target=/tmp/.diffbot.xauth,type=bind"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/tmp/.diffbot.xauth",
    "QT_X11_NO_MITSHM": "1"
  },
  "postCreateCommand": "bash .devcontainer/noetic/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python"
      ]
    }
  }
}
