{
  "name": "DiffBot (ROS 1 Noetic)",
  // Build the image from the Dockerfile. The build context is the repository root, so the
  // Dockerfile can copy all package.xml files.
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  // Work in the container as the user ros, not as root
  "remoteUser": "ros",
  // Mount your clone as src/diffbot in the catkin workspace, and open that folder
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/catkin_ws/src/diffbot,type=bind",
  "workspaceFolder": "/home/ros/catkin_ws/src/diffbot",
  // Use the host's network, so ROS nodes in the container can talk to the robot and to nodes on the host
  "runArgs": ["--network=host"],
  // Display access for GUI programs (RViz, Gazebo, rqt), which use the host's X server (on Windows: WSLg):
  // - initializeCommand runs host-x11.sh on the host before the container starts; it copies the
  //   X11 cookie of a native Linux desktop to .x11/xauth
  // - mounts: the X socket folder, through which the programs reach the X server
  // - DISPLAY says which display to use, XAUTHORITY where the cookie is (in the mounted clone),
  //   and QT_X11_NO_MITSHM stops Qt programs from using shared memory with the X server, which
  //   doesn't work from a container
  "initializeCommand": "bash .devcontainer/noetic/host-x11.sh",
  "mounts": ["source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/home/ros/catkin_ws/src/diffbot/.devcontainer/noetic/.x11/xauth",
    "QT_X11_NO_MITSHM": "1"
  },
  // Run setup.sh once per new container: clone the other repositories, install missing
  // dependencies, build the workspace
  "postCreateCommand": "bash .devcontainer/noetic/setup.sh",
  "customizations": {
    "vscode": {
      // Install VS Code's C++ and Python extensions in the container
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python"
      ]
    }
  }
}
