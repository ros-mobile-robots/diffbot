{
  "name": "DiffBot (ROS 1 Noetic)",
  // Build the image from the Dockerfile. The build context is the repository root, so the
  // Dockerfile can copy all package.xml files.
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  // Work in the container as the user ros, not as root
  "remoteUser": "ros",
  // Mount your clone of this repository (the folder you opened, localWorkspaceFolder) into the
  // catkin workspace as src/diffbot, and open that folder
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/catkin_ws/src/diffbot,type=bind",
  "workspaceFolder": "/home/ros/catkin_ws/src/diffbot",
  // Use the host's network, so ROS nodes in the container can talk to the robot and to nodes on the host
  "runArgs": ["--network=host"],
  // Display access for the GUI programs in the container (RViz, Gazebo, rqt). They open their
  // windows through the host's X server (on Windows: WSLg's):
  // - initializeCommand runs host-x11.sh on the host before the container starts. On a native
  //   Linux desktop, it copies the display's X11 cookie (the secret the X server asks programs
  //   for) from your Xauthority file to .devcontainer/noetic/.x11/xauth in your clone
  // - mounts: the host's X socket folder, through which the programs in the container connect to
  //   the X server
  // - DISPLAY: the host's DISPLAY variable (localEnv), such as :0; desktop sessions and WSLg set it
  // - XAUTHORITY: where X programs look for the cookie: the file host-x11.sh writes, which the
  //   container sees through the mount of your clone above
  // - QT_X11_NO_MITSHM is an old Qt 4 setting that turns off shared memory with the X server;
  //   the Qt 5 programs here ignore it and stop using shared memory by themselves when it fails
  "initializeCommand": "bash .devcontainer/noetic/host-x11.sh",
  "mounts": ["source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/home/ros/catkin_ws/src/diffbot/.devcontainer/noetic/.x11/xauth",
    "QT_X11_NO_MITSHM": "1"
  },
  // Run setup.sh once per new container: clone rplidar_ros and remo_description, install missing
  // dependencies, build the workspace
  "postCreateCommand": "bash .devcontainer/noetic/setup.sh",
  "customizations": {
    "vscode": {
      // Install VS Code's C++ and Python extensions in the container
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python"
      ]
    }
  }
}
