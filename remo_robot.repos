repositories:
  src/rplidar_ros:
    type: git
    url: https://github.com/ros-mobile-robots/rplidar_ros
    # One commit of the lidar driver's branch noetic-devel instead of the branch itself. The
    # robot image is built twice, once per processor architecture, and both builds fetch this
    # repository. With the commit, both get the same driver, also when one build runs later.
    # To move to a newer driver, write the new commit here: git ls-remote <url> noetic-devel
    version: 0c474e311f925f81ffba97313745f80a2de02e68
#  src/raspicam_node:
#    type: git
#    url: https://github.com/UbiquityRobotics/raspicam_node
#    version: kinetic
  src/remo_description:
    type: git
    url: https://github.com/ros-mobile-robots/remo_description
    # Pinned to one version of Remo's model instead of main. A new version reaches this workspace
    # and the diffbot repository's CI only through a pull request in the diffbot repository that
    # moves the pin, so the diffbot packages are tested with it first. diffbot_dev.repos and
    # remo_robot.repos pin the same version. The simulation passes the xacro argument imu_plugin,
    # which the model has since 2.5.0.
    version: "2.7.0"
