repositories:
  src/rplidar_ros:
    type: git
    url: https://github.com/ros-mobile-robots/rplidar_ros
    version: noetic-devel
  src/remo_description:
    type: git
    url: https://github.com/ros-mobile-robots/remo_description
    # Pinned to one version of Remo's model instead of main. A new version reaches this workspace
    # and the diffbot repository's CI only through a pull request in the diffbot repository that
    # moves the pin, so the diffbot packages are tested with it first. diffbot_dev.repos and
    # remo_robot.repos pin the same version.
    version: "2.0.0"
