<launch>
    <!-- The simulated robot's controllers. Included by diffbot_gazebo/launch/diffbot.launch,
         diffbot_control/launch/diffbot.launch and diffbot_gazebo/test/sim_drive.launch. Includes
         ekf.launch if ekf is true. A figure of which launch file includes which:
         https://ros-mobile-robots.com/packages/imu/robot_localization/#which-launch-file-starts-what -->
    <!-- 
        Launch file follows: 
        http://gazebosim.org/tutorials?tut=ros_control#Createaroslaunchfile
    -->
    <!--arg name="model" default="$(env DIFFBOT_MODEL)" doc="model type [diffbot, remo]"/-->
    <arg name="model" default="diffbot" doc="model type [diffbot, remo]"/>
    <arg name="rqt_robot_steering" default="true" doc="start rqt_robot_steering, a window with sliders to drive the robot"/>
    <arg name="ekf" default="false" doc="fuse the IMU's yaw rate with the wheel odometry in an EKF (diffbot_control/launch/ekf.launch)"/>

    <!-- Load controller configurations from YAML file to parameter server -->
    <rosparam command="load"
        file="$(find diffbot_control)/config/diffbot_control.yaml"/>

    <!-- The robot's wheel radius and separation -->
    <rosparam command="load"
        file="$(find diffbot_control)/config/$(arg model)/geometry.yaml"/>

    <!-- Gazebo's wheel velocity gains for this robot -->
    <rosparam command="load"
        file="$(find diffbot_control)/config/$(arg model)/pid.yaml"/>

    <!-- What the two lines below do with the ekf argument. The comment at the same two lines
         in diffbot_base/launch/diffbot.launch explains the expression:
         1. The param line sets the drive controller's enable_odom_tf to false with the EKF and
            to true without it. So one node publishes the transform odom → base_footprint on
            the topic /tf: the EKF with ekf true, the drive controller otherwise.
         2. The include line starts the EKF (ekf.launch) only if ekf is true.
         The EKF needs the transform between imu_link and base_footprint, which TF gets from
         the robot_state_publisher that this file starts further down -->
    <param name="/diffbot/mobile_base_controller/enable_odom_tf" type="bool" value="$(eval not arg('ekf'))"/>
    <include if="$(arg ekf)" file="$(find diffbot_control)/launch/ekf.launch"/>

    <!-- load the controllers -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
        output="screen" ns="diffbot" args="joint_state_controller
                                            mobile_base_controller"/>


    <!-- convert joint states to TF transforms for rviz, etc -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"
        ns="diffbot" respawn="false" output="screen">
        <remap from="/joint_states" to="/diffbot/joint_states" />
        <!-- param name="publish_frequency" type="double" value="30.0" /-->
    </node>

    <!-- Only started when the rqt_robot_steering argument is true (the default). It opens a window,
         so the simulation tests (diffbot_gazebo/test/sim_drive.launch) set it to false: they run
         without a display and send the velocity commands themselves -->
    <node if="$(arg rqt_robot_steering)" name="rqt_robot_steering" pkg="rqt_robot_steering" type="rqt_robot_steering">
        <param name="default_topic" value="/diffbot/mobile_base_controller/cmd_vel"/>
    </node>
</launch>
